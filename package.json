{
  "name": "movescript",
  "version": "1.0.0",
  "description": "Modularized MoveScript project",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:e2e": "playwright test -c config/playwright.config.js",
    "lint": "eslint --config config/eslint.config.js src/ electron/"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.4.1",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "three": "^0.187.0"
  }
}
