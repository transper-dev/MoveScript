{
  "name": "MoveScriptVR",
  "version": "1.1.0",
  "description": "Motor de coreografías 3D mediante código",
  "main": "main-electron.js",
  "scripts": {
    "prestart": "node generar-lista.js",
    "start": "electron .",
    "prebuild": "node generar-lista.js",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "subir": "node generar-lista.js && git add . && git commit -m \"Actualización de bailes\" && git push"
  },
  "author": "Urki Aristu",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.movescript.app",
    "productName": "MoveScriptVR",
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon.icns"
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-osc": "^11.7.0",
    "socket.io": "^4.8.3"
  }
}