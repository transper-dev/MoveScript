{
  "name": "movescript",
  "version": "1.0.0",
  "description": "Modularized MoveScript project",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"tests/**/*.test.js\" --test-coverage-lines=75 --test-coverage-branches=69 --test-coverage-functions=50 \"tests/**/*.test.js\"",
    "test:e2e": "playwright test -c config/playwright.config.js",
    "lint": "eslint --config config/eslint.config.js src/",
    "coverage:full": "c8 --all --include \"src/**/*.js\" --exclude \"tests/**/*.test.js\" node --test \"tests/**/*.test.js\"",
    "build:web": "vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "build": "npm run build:web",
    "prebuild": "node generar-lista.js",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "codemirror": "^5.65.13",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "c8": "^10.1.2",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "vite": "^6.0.0"
  }
}
